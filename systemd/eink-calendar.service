[Unit]
Description=E-Ink Kalender-Dashboard aktualisieren
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/E_Ink_Calendar_Dashboard
Environment=PYTHONPATH=/home/pi/E_Ink_Calendar_Dashboard/src:/home/pi/E_Ink_Calendar_Dashboard/lib
ExecStart=/home/pi/E_Ink_Calendar_Dashboard/.venv/bin/python -m eink_calendar
