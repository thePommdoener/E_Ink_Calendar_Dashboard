# Vorlage – wird von scripts/install_service.sh ausgefüllt (@USER@, @DIR@).
[Unit]
Description=E-Ink Kalender-Dashboard aktualisieren
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@DIR@
Environment=PYTHONPATH=@DIR@/src:@DIR@/lib
ExecStart=@DIR@/.venv/bin/python -m eink_calendar
